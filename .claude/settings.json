{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(dist/**)",
      "Edit(dist/**)",
      "Write(node_modules/**)",
      "Edit(node_modules/**)",
      "Write(.angular/**)",
      "Edit(.angular/**)",
      "Write(**/package-lock.json)",
      "Edit(**/package-lock.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "gitkraken@claude-plugins-official": true,
    "design@knowledge-work-plugins": true,
    "engineering@knowledge-work-plugins": true,
    "marketing@knowledge-work-plugins": true,
    "product-management@knowledge-work-plugins": true,
    "cowork-plugin-management@knowledge-work-plugins": true
  }
}
