{
  "name": "fuda",
  "version": "0.0.0",
  "description": "Fuda, design system inspiré du hanafuda, en composants Angular.",
  "license": "MIT",
  "module": "dist/fuda/fesm2022/fuda.mjs",
  "typings": "dist/fuda/types/fuda.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/fuda/types/fuda.d.ts",
      "default": "./dist/fuda/fesm2022/fuda.mjs"
    },
    "./styles/*": "./dist/fuda/styles/*"
  },
  "files": [
    "dist/fuda"
  ],
  "scripts": {
    "ng": "ng",
    "build": "npm run tokens && ng build fuda",
    "test": "ng test fuda",
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc -p projects/fuda/tsconfig.lib.json --noEmit && tsc -p projects/fuda/tsconfig.spec.json --noEmit && tsc -p projects/fuda/.storybook/tsconfig.json --noEmit",
    "lint": "ng lint",
    "storybook": "ng run fuda:storybook",
    "build-storybook": "ng run fuda:build-storybook",
    "e2e": "playwright test",
    "prepare": "npm run build"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular/animations": "^22.2.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/angular-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "sass": "^1.105.1",
    "storybook": "^10.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
